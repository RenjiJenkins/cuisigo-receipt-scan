# Copy to .env and fill in. .env is git-ignored; never commit real keys.

# Gemini API key from https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Optional overrides
GEMINI_MODEL=gemini-3.8-flash
# Used if the main model is overloaded (503) or rate-limited. Leave empty to disable.
GEMINI_FALLBACK_MODEL=gemini-3.5-flash-lite
# Set to 1 to return a canned receipt without calling Gemini (offline demos)
RECEIPT_MOCK=0
